{
  "permissions": {
    "allow": [
      "Bash(rm .git/hooks/*)",
      "Bash(rm -f .git/hooks/*)",
      "Edit(//home/user/civicos-process/**)",
      "Write(//home/user/civicos-process/**)",
      "mcp__Claude_Code_Remote__archive_session",
      "mcp__github__merge_pull_request",
      "mcp__claude-code-remote__archive_session",
      "mcp__claude-code-remote__delete_trigger",
      "Bash(node tools/mail.mjs xcheck:*)",
      "Bash(node /home/user/civicos-process/tools/mail.mjs xcheck:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/probe.sh start",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/probe.sh stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
